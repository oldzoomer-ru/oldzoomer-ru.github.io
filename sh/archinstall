#!/bin/bash
set -e

# ==========================================
# Конфигурация установки
# ==========================================
DISK="/dev/nvme0n1"
EFI_PART="${DISK}p1"
LUKS_PART="${DISK}p2"
LUKS_NAME="root"
HOSTNAME="oldzoomer-laptop"
TIMEZONE="Europe/Moscow"

# ==========================================
# 1. Проверки
# ==========================================
if [[ $EUID -ne 0 ]]; then
   echo "❌ Этот скрипт должен быть запущен от root"
   exit 1
fi

if [ ! -d /sys/firmware/efi/efivars ]; then
   echo "❌ Система загружена не в режиме UEFI. Перезагрузите компьютер в UEFI режиме."
   exit 1
fi

if ! ping -c 1 archlinux.org &> /dev/null; then
   echo "❌ Нет подключения к интернету. Проверьте сеть (например, через nmtui)."
   exit 1
fi

echo "⚠️  ВСТАВЬТЕ YubiKey в USB-порт."
read -p "Нажмите Enter, когда ключ вставлен и вы готовы..."

# ==========================================
# 2. Разметка диска
# ==========================================
echo "🔄 Очистка и разметка диска ${DISK}..."
sgdisk --zap-all ${DISK}
sgdisk -n 1:0:+512M -t 1:ef00 ${DISK}
sgdisk -n 2:0:0 -t 2:8309 ${DISK}

# ==========================================
# 3. Шифрование LUKS2 + FIDO2
# ==========================================
echo "🔐 Форматирование LUKS2..."
cryptsetup luksFormat --type luks2 --cipher aes-xts-plain64 --hash sha512 --iter-time 5000 ${LUKS_PART}

echo "🔓 Открытие LUKS..."
cryptsetup open ${LUKS_PART} ${LUKS_NAME}

echo "🔑 Регистрация FIDO2 для разблокировки LUKS (коснитесь ключа при запросе)..."
systemd-cryptenroll --fido2-device=auto ${LUKS_PART}

LUKS_UUID=$(blkid -s UUID -o value ${LUKS_PART})
echo "✅ UUID LUKS-раздела: ${LUKS_UUID}"

# ==========================================
# 4. Файловые системы (NILFS2)
# ==========================================
echo "💾 Форматирование EFI и NILFS2..."
mkfs.fat -F32 ${EFI_PART}
mkfs.nilfs2 /dev/mapper/${LUKS_NAME}

# ==========================================
# 5. Подготовка точек монтирования
# ==========================================
echo "📁 Монтирование разделов..."
mount /dev/mapper/${LUKS_NAME} /mnt
mkdir -p /mnt/boot
mount ${EFI_PART} /mnt/boot

# ==========================================
# 6. Установка базовой системы
# ==========================================
echo "📦 Установка пакетов..."
reflector --country Russia --age 12 --protocol https --sort rate \
      --save /etc/pacman.d/mirrorlist 2>/dev/null || true

pacstrap -K /mnt \
    base linux linux-firmware amd-ucode \
    nano man-db tree less bash-completion \
    nilfs-utils \
    gnome-shell gnome-control-center nautilus gnome-console flatpak gdm gnome-keyring \
    networkmanager openssh \
    pipewire pipewire-pulse pipewire-alsa wireplumber \
    bluez bluez-utils cups avahi nss-mdns \
    power-profiles-daemon \
    pam-u2f kbd \
    nvidia-open switcheroo-control \
    podman distrobox \
    apparmor \
    base-devel git libfido2 efibootmgr \
    plymouth

# ==========================================
# 7. Базовая настройка (Chroot)
# ==========================================
echo "📝 Генерация fstab..."
genfstab -U /mnt >> /mnt/etc/fstab

echo "🔐 Блокировка root-аккаунта (без пароля)..."
arch-chroot /mnt passwd -l root

echo "🔗 Настройка resolv.conf..."
ln -sf ../run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

# ==========================================
# 8. Интерактивное создание пользователя и регистрация ключа
# ==========================================
echo "👤 Настройка основного пользователя..."
read -p "Введите имя основного пользователя (латиницей, например, egor): " MAIN_USER < /dev/tty
read -s -p "Введите пароль для ${MAIN_USER}: " MAIN_USER_PASS < /dev/tty
echo ""

echo "⚠️  КОСНИТЕСЬ YubiKey для регистрации..."
arch-chroot /mnt /bin/bash << USER_SETUP
useradd -m -G wheel,audio,video,network,storage,input -s /bin/bash "${MAIN_USER}"
echo "${MAIN_USER}:${MAIN_USER_PASS}" | chpasswd
USER_SETUP

arch-chroot /mnt /bin/bash -c "pamu2fcfg -u '${MAIN_USER}' --origin=pam://${HOSTNAME} --appid=pam://${HOSTNAME} > /etc/u2f_mappings" < /dev/tty
arch-chroot /mnt chmod 600 /etc/u2f_mappings

echo "✅ Пользователь '${MAIN_USER}' создан, ключ зарегистрирован."

# ==========================================
# 9. Основная non-interactive настройка (Chroot)
# ==========================================
echo "⚙️ Настройка chroot окружения..."
arch-chroot /mnt /bin/bash << EOF
# Локаль и время
ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc
sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
sed -i 's/#ru_RU.UTF-8 UTF-8/ru_RU.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo "LANG=ru_RU.UTF-8" > /etc/locale.conf

# Консоль и шрифт
cat << 'VCONSOLE' > /etc/vconsole.conf
KEYMAP=ruwin_cplk-UTF-8
FONT=cyr-sun16
VCONSOLE

# Настройка клавиатуры для X11/Wayland
mkdir -p /etc/X11/xorg.conf.d
cat << 'XKB' > /etc/X11/xorg.conf.d/00-keyboard.conf
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "us,ru"
        Option "XkbOptions" "grp:caps_toggle"
EndSection
XKB

# Хост
echo "${HOSTNAME}" > /etc/hostname
cat << 'HOSTS' > /etc/hosts
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
HOSTS

# ==========================================
# mDNS и DNS через systemd-resolved + Avahi
# ==========================================
cat << 'RESOLVED' > /etc/systemd/resolved.conf
[Resolve]
DNS=77.88.8.8#common.dot.dns.yandex.net 77.88.8.1#common.dot.dns.yandex.net
DNSOverTLS=yes
FallbackDNS=
MulticastDNS=resolve
RESOLVED

sed -i 's/^hosts:.*/hosts: mymachines mdns_minimal [NOTFOUND=return] resolve [!UNAVAIL=return] files myhostname dns/' /etc/nsswitch.conf

# ==========================================
# NILFS2: Настройка PiTR и сборщика мусора
# ==========================================
# Храним сегменты 168 часов (7 дней) для непрерывного отката
sed -i 's/^#nhours = .*/nhours = 168/' /etc/nilfs_cleanerd.conf

# Создаем systemd-юнит для nilfs_cleanerd (отсутствует в пакете по умолчанию)
cat << 'NILFSSERVICE' > /etc/systemd/system/nilfs-cleanerd.service
[Unit]
Description=NILFS2 Garbage Collector Daemon
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/bin/nilfs_cleanerd
Restart=on-failure

[Install]
WantedBy=multi-user.target
NILFSSERVICE

systemctl enable nilfs-cleanerd.service

echo 'options nvidia NVreg_TemporaryFilePath=/tmp' >> /etc/modprobe.d/nvidia.conf

# ==========================================
# sudo для группы wheel
# ==========================================
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# ==========================================
# UKI + Plymouth + AppArmor + EFISTUB
# ==========================================
mkdir -p /etc/kernel
cat << CMDLINE > /etc/kernel/cmdline
root=/dev/mapper/root rw rd.luks.name=${LUKS_UUID}=root fido2-device=auto lsm=landlock,lockdown,yama,integrity,apparmor,bpf quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0
CMDLINE

sed -i 's/^#default_uki=/default_uki=/' /etc/mkinitcpio.d/linux.preset
sed -i 's|^default_uki=.*|default_uki="/boot/EFI/Linux/arch-linux.efi"|' /etc/mkinitcpio.d/linux.preset
sed -i 's/^default_image=/#default_image=/' /etc/mkinitcpio.d/linux.preset

sed -i 's/^#fallback_uki=/fallback_uki=/' /etc/mkinitcpio.d/linux.preset
sed -i 's|^fallback_uki=.*|fallback_uki="/boot/EFI/Linux/arch-linux-fallback.efi"|' /etc/mkinitcpio.d/linux.preset
sed -i 's/^fallback_image=/#fallback_image=/' /etc/mkinitcpio.d/linux.preset

mkdir -p /boot/EFI/Linux

# ВАЖНО: Удален хук 'fsck', так как NILFS2 не имеет полноценного fsck-хелпера
sed -i 's/^HOOKS=.*/HOOKS=(base systemd plymouth autodetect microcode modconf keyboard sd-vconsole block sd-encrypt filesystems)/' /etc/mkinitcpio.conf

# Добавляем утилиты nilfs в initramfs на случай аварийного восстановления
sed -i 's/^#BINARIES=.*/BINARIES=(nilfs_cleanerd lscp mkcp rmcp)/' /etc/mkinitcpio.conf

mkinitcpio -P

# EFISTUB записи
echo "⚙️  Создание записей загрузки EFISTUB..."
efibootmgr --create --disk ${DISK} --part 1 --label "Arch Linux" --loader '\EFI\Linux\arch-linux.efi'
efibootmgr --create --disk ${DISK} --part 1 --label "Arch Linux Fallback" --loader '\EFI\Linux\arch-linux-fallback.efi'

# ==========================================
# Включение сервисов
# ==========================================
systemctl enable systemd-resolved NetworkManager
systemctl enable gdm switcheroo-control
systemctl enable bluetooth cups avahi-daemon
systemctl enable apparmor
EOF

U2F_PAM_RULE="auth sufficient pam_u2f.so cue authfile=/etc/u2f_mappings origin=pam://${HOSTNAME} appid=pam://${HOSTNAME}"
echo "============================================================"
echo "⚠️  ВАЖНО: Добавьте следующую строку в /etc/pam.d/system-auth:"
echo "${U2F_PAM_RULE}"
echo "============================================================"
echo "✅ Установка успешно завершена!"
echo "🔌 Извлеките YubiKey и введите 'reboot' для перезагрузки."