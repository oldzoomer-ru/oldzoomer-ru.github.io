#!/bin/bash
set -e

# Конфигурация
DISK="/dev/nvme0n1"
EFI_PART="${DISK}p1"
LUKS_PART="${DISK}p2"
LUKS_NAME="root"
HOSTNAME="oldzoomer-laptop"
TIMEZONE="Europe/Moscow"

# Проверки
if [[ $EUID -ne 0 ]]; then
   echo "Ошибка: скрипт должен быть запущен от root"
   exit 1
fi

if [ ! -d /sys/firmware/efi/efivars ]; then
   echo "Ошибка: система загружена не в режиме UEFI"
   exit 1
fi

if ! ping -c 1 archlinux.org &> /dev/null; then
   echo "Ошибка: нет подключения к интернету"
   exit 1
fi

echo "Вставьте YubiKey в USB-порт."
read -p "Нажмите Enter, когда ключ вставлен и вы готовы..."

# Разметка диска
sgdisk --zap-all ${DISK}
sgdisk -n 1:0:+512M -t 1:ef00 ${DISK}
sgdisk -n 2:0:0 -t 2:8309 ${DISK}

# Шифрование LUKS2 + FIDO2
cryptsetup luksFormat --type luks2 --cipher aes-xts-plain64 --hash sha512 --iter-time 5000 ${LUKS_PART}
cryptsetup open ${LUKS_PART} ${LUKS_NAME}
systemd-cryptenroll --fido2-device=auto ${LUKS_PART}

LUKS_UUID=$(blkid -s UUID -o value ${LUKS_PART})

# Файловые системы BTRFS
mkfs.fat -F32 ${EFI_PART}
mkfs.btrfs -f -L arch-root /dev/mapper/${LUKS_NAME}

mount /dev/mapper/${LUKS_NAME} /mnt
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home

# Установка @ как дефолтного сабвольюма (критично для snapper rollback + UKI)
SUBVOL_ID=$(btrfs subvolume list /mnt | grep 'path @$' | awk '{print $2}')
btrfs subvolume set-default ${SUBVOL_ID} /mnt
umount /mnt

# Монтирование
# Корень монтируется без subvol=, чтобы использовался дефолтный сабвольюм
mount -o noatime,compress=zstd /dev/mapper/${LUKS_NAME} /mnt

mkdir -p /mnt/home
mount -o noatime,compress=zstd,subvol=@home /dev/mapper/${LUKS_NAME} /mnt/home

mkdir -p /mnt/boot
mount ${EFI_PART} /mnt/boot

# Установка базовой системы
reflector --country Russia --age 12 --protocol https --sort rate \
      --save /etc/pacman.d/mirrorlist 2>/dev/null || true

pacstrap -K /mnt \
    base linux linux-firmware amd-ucode \
    nano man-db tree less bash-completion \
    btrfs-progs snapper snap-pac \
    zram-generator \
    gnome-shell gnome-control-center nautilus gnome-console flatpak gdm gnome-keyring \
    networkmanager openssh \
    pipewire pipewire-pulse pipewire-alsa wireplumber \
    bluez bluez-utils cups avahi nss-mdns \
    power-profiles-daemon \
    pam-u2f kbd \
    nvidia-open switcheroo-control \
    podman distrobox \
    apparmor \
    base-devel git libfido2 efibootmgr \
    plymouth

# Базовая настройка
genfstab -U /mnt >> /mnt/etc/fstab
# Замена subvol=@ на subvolid=0 для поддержки snapper rollback
sed -i 's/subvol=@/subvolid=0/' /mnt/etc/fstab

arch-chroot /mnt passwd -l root
ln -sf ../run/systemd/resolve/stub-resolv.conf /mnt/etc/resolv.conf

# Создание пользователя
read -p "Введите имя основного пользователя (латиницей): " MAIN_USER < /dev/tty
read -s -p "Введите пароль для ${MAIN_USER}: " MAIN_USER_PASS < /dev/tty
echo ""

arch-chroot /mnt /bin/bash << USER_SETUP
useradd -m -G wheel,audio,video,network,storage,input -s /bin/bash "${MAIN_USER}"
echo "${MAIN_USER}:${MAIN_USER_PASS}" | chpasswd
USER_SETUP

arch-chroot /mnt /bin/bash -c "pamu2fcfg -u '${MAIN_USER}' --origin=pam://${HOSTNAME} --appid=pam://${HOSTNAME} > /etc/u2f_mappings" < /dev/tty
arch-chroot /mnt chmod 600 /etc/u2f_mappings

# Настройка chroot окружения
arch-chroot /mnt /bin/bash << EOF
ln -sf /usr/share/zoneinfo/${TIMEZONE} /etc/localtime
hwclock --systohc
sed -i 's/#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen
sed -i 's/#ru_RU.UTF-8 UTF-8/ru_RU.UTF-8 UTF-8/' /etc/locale.gen
locale-gen
echo "LANG=ru_RU.UTF-8" > /etc/locale.conf

cat << 'VCONSOLE' > /etc/vconsole.conf
KEYMAP=ruwin_cplk-UTF-8
FONT=cyr-sun16
VCONSOLE

mkdir -p /etc/X11/xorg.conf.d
cat << 'XKB' > /etc/X11/xorg.conf.d/00-keyboard.conf
Section "InputClass"
        Identifier "system-keyboard"
        MatchIsKeyboard "on"
        Option "XkbLayout" "us,ru"
        Option "XkbOptions" "grp:caps_toggle"
EndSection
XKB

echo "${HOSTNAME}" > /etc/hostname
cat << 'HOSTS' > /etc/hosts
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
HOSTS

cat << 'RESOLVED' > /etc/systemd/resolved.conf
[Resolve]
DNS=77.88.8.8#common.dot.dns.yandex.net 77.88.8.1#common.dot.dns.yandex.net
DNSOverTLS=yes
FallbackDNS=
MulticastDNS=resolve
RESOLVED

sed -i 's/^hosts:.*/hosts: mymachines mdns_minimal [NOTFOUND=return] resolve [!UNAVAIL=return] files myhostname dns/' /etc/nsswitch.conf

# Snapper
snapper --no-dbus -c root create-config /
snapper --no-dbus -c home create-config /home

sed -i 's/^TIMELINE_LIMIT_HOURLY=".*"/TIMELINE_LIMIT_HOURLY="0"/' /etc/snapper/configs/root
sed -i 's/^TIMELINE_LIMIT_DAILY=".*"/TIMELINE_LIMIT_DAILY="7"/' /etc/snapper/configs/root
sed -i 's/^TIMELINE_LIMIT_WEEKLY=".*"/TIMELINE_LIMIT_WEEKLY="4"/' /etc/snapper/configs/root
sed -i 's/^TIMELINE_LIMIT_MONTHLY=".*"/TIMELINE_LIMIT_MONTHLY="0"/' /etc/snapper/configs/root

sed -i 's/^TIMELINE_LIMIT_HOURLY=".*"/TIMELINE_LIMIT_HOURLY="24"/' /etc/snapper/configs/home
sed -i 's/^TIMELINE_LIMIT_DAILY=".*"/TIMELINE_LIMIT_DAILY="30"/' /etc/snapper/configs/home
sed -i 's/^TIMELINE_LIMIT_WEEKLY=".*"/TIMELINE_LIMIT_WEEKLY="12"/' /etc/snapper/configs/home
sed -i 's/^TIMELINE_LIMIT_MONTHLY=".*"/TIMELINE_LIMIT_MONTHLY="12"/' /etc/snapper/configs/home

systemctl enable snapper-timeline.timer
systemctl enable snapper-cleanup.timer

# ZRAM
cat << 'ZRAMCONF' > /etc/systemd/zram-generator.conf
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
ZRAMCONF

# PAM U2F
awk '/^auth[[:space:]]+required[[:space:]]+pam_faillock\.so.*preauth/ {
    print
    print "auth sufficient pam_u2f.so cue authfile=/etc/u2f_mappings origin=pam://${HOSTNAME} appid=pam://${HOSTNAME}"
    next
}
{print}' /etc/pam.d/system-auth > /etc/pam.d/system-auth.tmp && mv /etc/pam.d/system-auth.tmp /etc/pam.d/system-auth

# Sudo
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

# UKI + Plymouth + AppArmor + EFISTUB
mkdir -p /etc/kernel
# rootflags без subvol=@: ядро монтирует дефолтный сабвольюм (поддержка snapper rollback)
# Добавлен nvidia_drm.modeset=1 для корректной работы Plymouth и Early KMS с NVIDIA
cat << CMDLINE > /etc/kernel/cmdline
root=/dev/mapper/root rw rootflags=compress=zstd rd.luks.name=${LUKS_UUID}=root fido2-device=auto lsm=landlock,lockdown,yama,integrity,apparmor,bpf quiet splash loglevel=3 rd.udev.log_level=3 vt.global_cursor_default=0 nvidia_drm.modeset=1
CMDLINE

sed -i 's/^#default_uki=/default_uki=/' /etc/mkinitcpio.d/linux.preset
sed -i 's|^default_uki=.*|default_uki="/boot/EFI/Linux/arch-linux.efi"|' /etc/mkinitcpio.d/linux.preset
sed -i 's/^default_image=/#default_image=/' /etc/mkinitcpio.d/linux.preset

mkdir -p /boot/EFI/Linux

# Ранняя загрузка модулей NVIDIA (Early KMS)
sed -i 's/^#*MODULES=.*/MODULES=(nvidia nvidia_modeset nvidia_uvm nvidia_drm)/' /etc/mkinitcpio.conf

# Настройка хуков: добавлен fsck перед filesystems
sed -i 's/^HOOKS=.*/HOOKS=(base systemd plymouth autodetect microcode modconf keyboard sd-vconsole block sd-encrypt fsck filesystems)/' /etc/mkinitcpio.conf

mkinitcpio -P

# Очистка и создание записей загрузки
efibootmgr | grep -i "Arch Linux" | awk '{print \$1}' | sed 's/[^0-9]//g' | while read bootnum; do
    efibootmgr -b \$bootnum -B 2>/dev/null || true
done

efibootmgr --create --disk ${DISK} --part 1 --label "Arch Linux" --loader '\\EFI\\Linux\\arch-linux.efi'

# Сервисы
systemctl enable systemd-resolved NetworkManager
systemctl enable gdm switcheroo-control
systemctl enable bluetooth cups avahi-daemon
systemctl enable apparmor
EOF

echo "Установка завершена."
echo "Извлеките YubiKey и выполните reboot."